APP_NAME=Path Service
APP_VERSION=1.0.0
APP_PORT=8006

# Database configuration (uses the path-db container name)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@path-db:5432/path_service_db

# Downstream service URLs (using host.docker.internal to reach services in the other compose group)
CONTENT_SERVICE_BASE_URL=http://host.docker.internal:8002
PROGRESS_SERVICE_BASE_URL=http://host.docker.internal:8003
ANALYTICS_SERVICE_BASE_URL=http://host.docker.internal:8004

HTTP_TIMEOUT_SECONDS=10.0
ADMIN_JWT_SECRET_KEY=replace-with-a-long-random-secret-for-production
ADMIN_JWT_ALGORITHM=HS256
